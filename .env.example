# Table Picker V2 - Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# LLM Provider API Keys
# =============================================================================
# At least one API key is required for the LLM-based table selector.
# The system uses the aretai library which supports multiple providers.

# Groq API Key (default provider - fast inference)
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude) API Key
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# xAI (Grok) API Key
# Get your API key from: https://x.ai/
XAI_API_KEY=your_xai_api_key_here

# =============================================================================
# Models
# =============================================================================

# Choose any models supported by Aretai provider list
MODEL=moonshotai/kimi-k2-instruct-0905


# =============================================================================
# Optional Configuration
# =============================================================================

# Default LLM Provider (if not specified via command line)
# Options: groq, openai, anthropic, grok
# PROVIDER=groq

# Metadata file path (if not using default src/data/table_metadata_full.json)
# METADATA_PATH=src/data/table_metadata_full.json

# =============================================================================
# Notes
# =============================================================================
# - The aretai library automatically loads these variables from .env files
# - You only need to set the API key for the provider you plan to use
# - The default provider is "groq" if not specified
# - API keys are read from environment variables in this order:
#   1. Explicitly passed to SchemaSelectorService
#   2. Environment variables (this file)
#   3. System environment variables
